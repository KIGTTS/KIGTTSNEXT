<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KigttsNext" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#0E1414</item>
        <item name="android:colorAccent">@color/default_theme_seed</item>
    </style>
    <style name="Theme.KigttsNext.Starting" parent="Theme.KigttsNext">
        <item name="android:windowBackground">@drawable/startup_background</item>
        <item name="android:windowLightStatusBar">@bool/startup_light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/startup_light_bars</item>
    </style>
</resources>
